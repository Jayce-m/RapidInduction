# Neon connection string (Neon console > Connect). Keep the real value in .env only.
DATABASE_URL=

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin users see in the browser: the Vite dev server locally,
# https://app.rapidsequence.com in production.
BETTER_AUTH_URL=http://127.0.0.1:5190

# Vivas only. The rest of the app, migrations and seeding run without these.
# ElevenLabs API key and the id of the examiner agent (see README > Vivas).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_
# Marks finished vivas.
ANTHROPIC_API_KEY=
