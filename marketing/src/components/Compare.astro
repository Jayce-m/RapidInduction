---
import { compare } from '../content';
import Kicker from './Kicker.astro';
import Mark from './Mark.astro';
---

<section id="compare" class="px-4 py-24 sm:px-8">
	<div class="mx-auto max-w-[1216px]">
		<Kicker class="justify-center">{compare.kicker}</Kicker>
		<h2
			class="mt-3 text-center font-display text-[26px] leading-[34px] text-balance sm:text-[30px] sm:leading-[38px]"
		>
			{compare.title}
		</h2>

		<table class="mt-14 hidden w-full border-separate border-spacing-0 md:table">
			<caption class="sr-only">{compare.us} compared with {compare.them}</caption>
			<thead>
				<tr>
					<td class="w-[20%]"></td>
					<th
						scope="col"
						class="w-[40%] rounded-t-xl bg-[#632b24] px-7 pt-6 pb-8 text-left font-normal"
					>
						<span
							class="flex items-center gap-2 font-display text-[24px] text-white"
						>
							<Mark class="h-5 w-7 text-[#f0c9a8]" />
							{compare.us}
						</span>
					</th>
					<th
						scope="col"
						class="rounded-tr-xl border-t border-r px-7 py-6 text-left align-middle text-[15px] font-normal text-muted-foreground"
					>
						{compare.them}
					</th>
				</tr>
			</thead>
			<tbody class="text-[15px]">
				{
					compare.rows.map((row, i) => {
						const last = i === compare.rows.length - 1;
						return (
							<tr>
								<th
									scope="row"
									class:list={[
										'border-t border-l px-7 py-6 text-left font-normal',
										i === 0 && 'rounded-tl-xl',
										last && 'rounded-bl-xl border-b',
									]}
								>
									{row.feature}
								</th>
								<td
									class:list={[
										'border-t border-white/10 bg-[#632b24] px-7 py-6 text-white',
										last && 'rounded-b-xl',
									]}
								>
									{row.us}
								</td>
								<td
									class:list={[
										'border-t border-r px-7 py-6 text-muted-foreground',
										last && 'rounded-br-xl border-b',
									]}
								>
									{row.them}
								</td>
							</tr>
						);
					})
				}
			</tbody>
		</table>

		<ul class="mt-10 space-y-3 md:hidden">
			{
				compare.rows.map((row) => (
					<li class="overflow-hidden rounded-xl border">
						<p class="px-4 pt-4 pb-3 text-[15px] font-medium">{row.feature}</p>
						<p class="bg-[#632b24] px-4 py-3 text-sm text-white">
							<span class="block text-xs text-[#f0c9a8]">{compare.us}</span>
							{row.us}
						</p>
						<p class="px-4 py-3 text-sm text-muted-foreground">
							<span class="block text-xs">{compare.them}</span>
							{row.them}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
