---
import { Image } from 'astro:assets';
import { hero } from '../content';
import CtaButton from './CtaButton.astro';
---

<section class="px-4 pt-20 sm:px-8 sm:pt-28">
	<div class="mx-auto max-w-3xl text-center">
		<h1
			class="text-[44px] leading-[1.08] font-light tracking-[-0.03em] sm:text-[62px] sm:leading-[1.0]"
		>
			{hero.title.map((line) => <span class="block">{line}</span>)}
		</h1>
		<p
			class="mx-auto mt-6 max-w-xl text-[18px] leading-7 font-light text-muted-foreground sm:text-[20px]"
		>
			{hero.subtitle.map((line) => <span class="sm:block">{line} </span>)}
		</p>
		<CtaButton size="lg" class="mt-10 w-full sm:w-auto" />
		<p class="mt-5 text-sm font-medium text-[#6b5118]">{hero.guarantee}</p>
	</div>

	<div
		class="relative mx-auto mt-16 max-w-[1376px] overflow-hidden rounded-2xl bg-[#2a1a14] px-3 pt-10 pb-10 sm:px-20 sm:pt-16 sm:pb-16"
	>
		<div
			aria-hidden="true"
			class="absolute inset-0 bg-[radial-gradient(60%_80%_at_20%_0%,#7a4a33_0%,transparent_70%),radial-gradient(50%_70%_at_90%_100%,#5b2a20_0%,transparent_70%),linear-gradient(180deg,#3a241b,#22140f)]"
		>
		</div>
		<div
			aria-hidden="true"
			class="absolute inset-0 opacity-[0.07] [background-image:repeating-linear-gradient(90deg,#fff_0_1px,transparent_1px_46px)]"
		>
		</div>
		<Image
			src={hero.image}
			alt={hero.imageAlt}
			widths={[640, 1024, 1600, 2400]}
			sizes="(min-width: 1376px) 1216px, 92vw"
			loading="eager"
			fetchpriority="high"
			class="relative mx-auto w-full max-w-[1216px] rounded-xl shadow-[0_30px_80px_rgba(0,0,0,0.45)] ring-1 ring-white/10"
		/>
	</div>
</section>
