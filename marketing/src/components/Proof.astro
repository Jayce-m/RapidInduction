---
import { stats, testimonial } from '../content';
import Kicker from './Kicker.astro';
---

<section class="px-4 pt-16 pb-24 sm:px-8">
	<Kicker class="justify-center text-center">{stats.kicker}</Kicker>
	<dl
		class="mx-auto mt-10 grid max-w-[1216px] gap-8 sm:grid-cols-3 sm:gap-0 sm:divide-x"
	>
		{
			stats.items.map((item) => (
				<div class="flex flex-col-reverse items-center gap-2 px-6 text-center">
					<dt class="text-[16px] leading-6 font-light text-muted-foreground">
						{item.label}
					</dt>
					<dd class="font-display text-[52px] leading-none text-[#4a3a14]">
						{item.value}
					</dd>
				</div>
			))
		}
	</dl>

	<figure class="mx-auto mt-28 max-w-[820px] text-center">
		<blockquote class="font-display text-[20px] leading-[30px] text-balance">
			“{testimonial.quote}”
		</blockquote>
		<figcaption class="mt-6 inline-flex items-center gap-3 text-left">
			<span
				class="flex size-11 items-center justify-center rounded-full border border-[#ecd8c6] bg-[#fbf1e7] text-sm font-medium"
				aria-hidden="true"
			>
				{testimonial.name[0]}
			</span>
			<span>
				<span class="block text-[15px] font-medium">{testimonial.name}</span>
				<span class="block text-[15px] text-muted-foreground"
					>{testimonial.role}</span
				>
			</span>
		</figcaption>
	</figure>
</section>
