---
import { SIGNUP_URL } from '../config';

interface Props {
	size?: 'md' | 'lg';
	label?: string;
	class?: string;
}
const { size = 'md', label = 'Get started', class: className } = Astro.props;
---

<a
	href={SIGNUP_URL}
	class:list={[
		'inline-flex items-center justify-center gap-2 rounded-full border border-primary-border bg-primary text-primary-foreground shadow-primary-button transition hover:bg-primary-border focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-none active:scale-[0.98]',
		size === 'lg' ? 'h-11 px-9 text-[18px]' : 'h-11 px-9 text-[17px]',
		className,
	]}
>
	{label}
	<svg
		viewBox="0 0 16 16"
		class="size-3.5"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m6 3.5 4.5 4.5L6 12.5"></path>
	</svg>
</a>
