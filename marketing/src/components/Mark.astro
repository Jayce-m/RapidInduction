---
// A capnography trace: the waveform every anaesthetist watches at induction.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	viewBox="0 0 28 20"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	class={className}
>
	<path d="M1 16h4l2.5-11h9.5l1.5 2 1.5 9h7" />
</svg>
