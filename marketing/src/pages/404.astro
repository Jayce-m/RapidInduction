---
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Rapid Sequence" noindex>
	<Header />
	<main class="flex min-h-[70dvh] flex-col items-center justify-center px-4 text-center">
		<p class="font-display text-[72px] leading-none text-primary">404</p>
		<h1 class="mt-6 font-display text-[30px] leading-[38px]">
			Can't intubate, can't find this page.
		</h1>
		<p class="mt-3 text-muted-foreground">
			Time to call for help. Or head back to somewhere familiar.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex h-10 items-center rounded-full bg-white px-6 shadow-pill hover:bg-muted"
		>
			Return to home
		</a>
	</main>
</Base>
