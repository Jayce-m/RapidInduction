---
import Advisors from '../components/Advisors.astro';
import Compare from '../components/Compare.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Marking from '../components/Marking.astro';
import Pricing from '../components/Pricing.astro';
import Proof from '../components/Proof.astro';
import Results from '../components/Results.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../config';
import { faq, pricing } from '../content';
import Base from '../layouts/Base.astro';

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: SITE_NAME,
		description: SITE_DESCRIPTION,
		applicationCategory: 'EducationalApplication',
		operatingSystem: 'Web',
		offers: [
			{
				'@type': 'Offer',
				name: 'Annual',
				price: pricing.plan.annualTotal,
				priceCurrency: 'AUD',
			},
			{
				'@type': 'Offer',
				name: 'Monthly',
				price: pricing.plan.standardMonthly,
				priceCurrency: 'AUD',
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.items.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer.join('\n\n') },
		})),
	},
];
---

<Base structuredData={structuredData}>
	<Header />
	<main>
		<Hero />
		<Proof />
		<HowItWorks />
		<Marking />
		<Compare />
		<Results />
		<Advisors />
		<Pricing />
		<Faq />
		<FinalCta />
	</main>
	<Footer />
</Base>
